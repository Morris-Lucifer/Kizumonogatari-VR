         return GuestExecutionFailure{GuestExecutionStage::Mapping,
                                      stack.Error() == 0 ? ENOMEM : stack.Error()};
     }
+
+    // RunGuestMain switches to a different mapping from the wrapper pthread's
+    // original stack. Guest stack queries (including Mono's GC root scan) must
+    // describe the stack actually used by the x86 execution context.
+    const char* stack_setting = std::getenv("BACHATA_FEX_MAIN_STACK");
+    const bool publish_guest_stack = !stack_setting || std::strcmp(stack_setting, "0") != 0;
+    auto* current_thread = Libraries::Kernel::g_curthread;
+    void* previous_stack{};
+    size_t previous_size{};
+    size_t previous_guard{};
+    if (current_thread) {
+        std::scoped_lock lock{current_thread->lock};
+        previous_stack = current_thread->attr.stackaddr_attr;
+        previous_size = current_thread->attr.stacksize_attr;
+        previous_guard = current_thread->attr.guardsize_attr;
+        LOG_INFO(Core_Linker,
+                 "FEX main stack: pthread={:#x}+{:#x} guest={:#x}+{:#x} publish={}",
+                 reinterpret_cast<VAddr>(previous_stack), previous_size,
+                 stack.Top() - stackSize, stackSize, publish_guest_stack);
+        if (publish_guest_stack) {
+            current_thread->attr.stackaddr_attr = reinterpret_cast<void*>(stack.Top() - stackSize);
+            current_thread->attr.stacksize_attr = stackSize;
+            current_thread->attr.guardsize_attr = 0;
+        }
+    }
+    SCOPE_EXIT {
+        // Restore before the mapping is released or the wrapper pthread exits.
+        if (current_thread && publish_guest_stack) {
+            std::scoped_lock lock{current_thread->lock};
+            current_thread->attr.stackaddr_attr = previous_stack;
+            current_thread->attr.stacksize_attr = previous_size;
+            current_thread->attr.guardsize_attr = previous_guard;
+        }
+    };
 
