+    u32 reserved_08[6];
+    OrbisVrTrackerCalibrationSettings calibration_settings;
+    void* direct_memory_onion;
+    u32 direct_memory_onion_size;
+    u32 direct_memory_onion_alignment;
+    void* direct_memory_garlic;
+    u32 direct_memory_garlic_size;
