+void Runtime::UpdateMove(u32 hand, const MoveState& state) {
+    if (hand >= host_moves.size()) return;
+    std::scoped_lock lock{mutex};
+    const u64 sequence = host_moves[hand].device.sequence + 1;
+    host_moves[hand] = state;
+    host_moves[hand].device.sequence = sequence;
+    move_received[hand] = std::chrono::steady_clock::now();
+}
+
+MoveState Runtime::GetMove(u32 hand) const {
+    std::scoped_lock lock{mutex};
+    if (hand >= host_moves.size()) return {};
+    MoveState state = host_moves[hand];
+    if (std::chrono::steady_clock::now() - move_received[hand] > std::chrono::milliseconds{250}) {
+        state.connected = false;
+        state.device.tracked = false;
+    }
+    if (!state.connected) {
+        state.buttons = 0;
+        state.trigger = 0;
+        state.device.tracked = false;
+    }
+    state.device.pose.position = PositionToTracker(state.device.pose.position);
+    state.device.pose.orientation = Normalize(Multiply(Conjugate(seat_yaw), state.device.pose.orientation));
+    state.device.linear_velocity = DirectionToTracker(state.device.linear_velocity);
+    state.device.angular_velocity = DirectionToTracker(state.device.angular_velocity);
+    return state;
+}
